# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# API — keep "/api" to use the same-origin proxy (recommended).
NEXT_PUBLIC_API_URL=/api
# Flask backend origin the /api/* rewrite proxies to.
# Local dev: http://localhost:5000 — Production: your backend Vercel URL,
# e.g. https://kodifly-meeting-room-api.vercel.app
BACKEND_URL=http://localhost:5000

# Used for password-reset redirect links (your frontend URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
