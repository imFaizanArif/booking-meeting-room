# Copy to apps/api/.env (local processes) and to .env at the repo root (Docker Compose).
# Every setting is documented in docs/DEVELOPMENT.md.
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
# Supabase is the only database. Project Settings -> Database -> Connection string. Paste it as
# shown (postgresql://...); the driver prefix is added for you.
#   direct:              postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
#   session pooler:      postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#   transaction pooler:  postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Database tests only: a SEPARATE Supabase project or branch. Tests drop and recreate the
# platform's tables there. Use the direct or session connection, not port 6543.
TEST_DATABASE_URL=
# "auto" turns on TLS for Supabase hosts and detects the transaction pooler (port 6543).
# DATABASE_POOLER: auto | none | session | transaction. DATABASE_SSL: auto | disable | require.
DATABASE_POOLER=auto
DATABASE_SSL=auto
DATABASE_POOL_SIZE=10
# Redis (job queue, pub/sub). Supabase does not replace it.
REDIS_URL=redis://localhost:6379/0
# 32 random bytes, base64: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
SECRETS_MASTER_KEY=
REALTIME_TOKEN_SECRET=
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_WEB_URL=http://localhost:3000
# Hosts/CIDRs that may resolve to private addresses (SSRF allow-list). Local dev needs localhost.
OUTBOUND_ALLOWLIST=["127.0.0.1","localhost"]
MCP_MAX_STDIO_PROCESSES=16
MCP_CONNECT_TIMEOUT_S=20
MCP_HEALTH_INTERVAL_S=30
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=10
WORKER_MAX_JOBS=20
LLM_DEFAULT_TIMEOUT_S=120
LOGIN_RATE_PER_MINUTE=10
MUTATION_RATE_PER_MINUTE=300
SEED_DEMO=true
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=admin-password
# Demo MCP servers
MOCK_JOBS_URL=http://127.0.0.1:8811/mcp
MOCK_MCP_STATE_DIR=/tmp/mock-mcp-state
# Web
API_URL=http://localhost:8000
