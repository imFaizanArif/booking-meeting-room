# Copy to apps/api/.env for local development. Every setting is documented in docs/DEVELOPMENT.md.
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/agent_platform
REDIS_URL=redis://localhost:6379/0
# Supabase / hosted Postgres. Use the asyncpg scheme with any of the connection strings Supabase shows:
#   direct:              postgresql+asyncpg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
#   session pooler:      postgresql+asyncpg://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#   transaction pooler:  postgresql+asyncpg://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# "auto" detects TLS (*.supabase.co/.com) and the transaction pooler (port 6543). Override if needed.
# DATABASE_POOLER: auto | none | session | transaction. DATABASE_SSL: auto | disable | require.
DATABASE_POOLER=auto
DATABASE_SSL=auto
DATABASE_POOL_SIZE=10
# 32 random bytes, base64: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
SECRETS_MASTER_KEY=
REALTIME_TOKEN_SECRET=
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_WEB_URL=http://localhost:3000
# Hosts/CIDRs that may resolve to private addresses (SSRF allow-list). Local dev needs localhost.
OUTBOUND_ALLOWLIST=["127.0.0.1","localhost"]
MCP_MAX_STDIO_PROCESSES=16
MCP_CONNECT_TIMEOUT_S=20
MCP_HEALTH_INTERVAL_S=30
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=10
WORKER_MAX_JOBS=20
LLM_DEFAULT_TIMEOUT_S=120
LOGIN_RATE_PER_MINUTE=10
MUTATION_RATE_PER_MINUTE=300
SEED_DEMO=true
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=admin-password
# Demo MCP servers
MOCK_JOBS_URL=http://127.0.0.1:8811/mcp
MOCK_MCP_STATE_DIR=/tmp/mock-mcp-state
# Web
API_URL=http://localhost:8000
