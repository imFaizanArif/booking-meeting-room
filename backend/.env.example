# --- Supabase ---------------------------------------------------------------
# Project settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: Project settings -> API -> JWT Settings -> JWT Secret.
# If empty, tokens are verified via the Supabase Auth API instead.
SUPABASE_JWT_SECRET=

# --- Database (Supabase Postgres, Session pooler recommended on Railway) -----
# Project settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- App ----------------------------------------------------------------------
FLASK_ENV=production
SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,https://kodifly-meeting-room.vercel.app
